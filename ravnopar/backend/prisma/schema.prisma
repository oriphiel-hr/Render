generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ProfileAvailability {
  AVAILABLE
  FOCUSED_CONTACT
  PAUSED
}

enum PairStatus {
  ACTIVE
  CLOSED
}

enum ContactStatus {
  PENDING
  ACCEPTED
  DECLINED
  AUTO_CLOSED
}

enum UserRole {
  USER
  ADMIN
}

enum ModerationReportStatus {
  OPEN
  IN_REVIEW
  RESOLVED
  DISMISSED
}

enum PaymentProvider {
  STRIPE
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  CANCELLED
}

enum AuditCategory {
  ADMIN_ACTION
  MODERATION
  SECURITY
  FEED_RANKING
  COMPLIANCE
}

model AuditEvent {
  id              String        @id @default(cuid())
  category        AuditCategory
  action          String
  actorProfileId  String?
  targetProfileId String?
  entityType      String?
  entityId        String?
  summary         String
  payload         Json          @default("{}")
  createdAt       DateTime      @default(now())

  @@index([category, createdAt])
  @@index([actorProfileId, createdAt])
  @@index([targetProfileId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
}

model ModerationDecision {
  id                  String   @id @default(cuid())
  reportId            String
  resolvedByProfileId String
  outcome             String
  actionTaken         String
  notes               String?
  createdAt           DateTime @default(now())

  @@index([reportId])
  @@index([resolvedByProfileId, createdAt])
  @@index([createdAt])
}

model UserProfile {
  id            String              @id @default(cuid())
  email         String              @unique
  displayName   String
  age           Int
  dateOfBirth   DateTime
  city          String
  country       String              @default("HR")
  locale        String              @default("hr")
  bio           String?
  identity      String              @default("OTHER")
  profileType   String              @default("INDIVIDUAL")
  seekingIdentities Json
  seekingProfileTypes Json
  intents       Json
  availability  ProfileAvailability @default(AVAILABLE)
  photos        Json                @default("[]")
  planTier      String              @default("free")
  notifyEmail   Boolean             @default(true)
  photoVerified Boolean             @default(false)
  onboardingDone Boolean            @default(false)
  icebreakers   Json                @default("[]")
  latitude      Float?
  longitude     Float?
  shareLocation Boolean             @default(false)
  videoUrl      String?
  verificationSelfie String?
  verificationPending Boolean        @default(false)
  referralCode      String?          @unique
  referredByProfileId String?
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  account       UserAccount?
}

model PairMessageEmailLog {
  pairId     String
  profileId  String
  lastSentAt DateTime @default(now()) @updatedAt

  @@id([pairId, profileId])
}

model EngagedPair {
  id           String     @id @default(cuid())
  userAId      String
  userBId      String
  sourceContactId String?
  status       PairStatus @default(ACTIVE)
  startedAt    DateTime   @default(now())
  endedAt      DateTime?
  closeReason  String?

  @@index([status, startedAt])
  @@index([userAId, userBId, status])
}

model MatchContact {
  id            String        @id @default(cuid())
  requesterId   String
  targetId      String
  status        ContactStatus @default(PENDING)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  @@index([requesterId, status, createdAt])
  @@index([targetId, status, createdAt])
}

model UserAccount {
  id              String   @id @default(cuid())
  profileId       String   @unique
  passwordHash    String
  role            UserRole @default(USER)
  verifiedAt      DateTime?
  suspendedAt     DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  profile         UserProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)
}

model EmailVerificationCode {
  id          String   @id @default(cuid())
  email       String
  code        String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([email, createdAt])
  @@index([email, code, expiresAt])
}

model UserBlock {
  id          String   @id @default(cuid())
  blockerId   String
  blockedId   String
  reason      String?
  createdAt   DateTime @default(now())

  @@unique([blockerId, blockedId])
  @@index([blockerId, createdAt])
}

model UserReport {
  id          String                 @id @default(cuid())
  reporterId  String
  reportedId  String
  reason      String
  details     String?
  status      ModerationReportStatus @default(OPEN)
  priority    Int                    @default(1)
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  @@index([status, priority, createdAt])
  @@index([reportedId, createdAt])
}

model UserRating {
  id          String   @id @default(cuid())
  fromUserId  String
  toUserId    String
  score       Int
  comment     String?
  createdAt   DateTime @default(now())

  @@index([toUserId, createdAt])
  @@index([fromUserId, createdAt])
}

model FairnessConfigChange {
  id             String   @id @default(cuid())
  changedByUserId String?
  oldDailyLimit  Int
  newDailyLimit  Int
  reason         String
  createdAt      DateTime @default(now())

  @@index([createdAt])
}

model PasswordResetCode {
  id          String   @id @default(cuid())
  email       String
  code        String
  expiresAt   DateTime
  consumedAt  DateTime?
  createdAt   DateTime @default(now())

  @@index([email, createdAt])
  @@index([email, code, expiresAt])
}

model PairReadState {
  id         String   @id @default(cuid())
  pairId     String
  profileId  String
  lastReadAt DateTime @default(now())

  @@unique([pairId, profileId])
  @@index([profileId])
}

model PairMessage {
  id        String   @id @default(cuid())
  pairId    String
  senderId  String
  body      String
  reaction  String?
  createdAt DateTime @default(now())

  @@index([pairId, createdAt])
}

model PaymentOrder {
  id                  String         @id @default(cuid())
  userProfileId       String
  provider            PaymentProvider
  status              PaymentStatus  @default(PENDING)
  amountCents         Int
  currency            String         @default("EUR")
  description         String
  stripeSessionId     String?
  bankTransferReference String?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([userProfileId, createdAt])
  @@index([status, createdAt])
}
