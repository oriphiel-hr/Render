APP_NAME="Oriphiel Atomic Ledger"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=UTC
APP_URL=https://oriphiel-atomic-ledger.onrender.com

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single,ledger
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=oriphiel_ledger
DB_USERNAME=oriphiel
DB_PASSWORD=secret

SESSION_DRIVER=cookie
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=true
SANCTUM_STATEFUL_DOMAINS=localhost,127.0.0.1,oriphiel-atomic-ledger.onrender.com
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
CACHE_PREFIX=oriphiel_

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="ledger@oriphiel.local"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

LEDGER_LOCK_TTL_SECONDS=10
LEDGER_LOCK_WAIT_SECONDS=5

# Binance Spot exchange bridge — EXCHANGE_MODE flag (testnet | production)
EXCHANGE_ENABLED=false
EXCHANGE_MODE=testnet
EXCHANGE_TIMEOUT=15
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET_BASE_URL=https://testnet.binance.vision
BINANCE_PRODUCTION_BASE_URL=https://api.binance.com

# Demo login (password: password)
# alice@demo.local · bob@demo.local · admin@demo.local
# EXCHANGE_MODE=production
# EXCHANGE_ENABLED=true
# + production ključevi s https://www.binance.com/en/my/settings/api-management

APP_PORT=8000
