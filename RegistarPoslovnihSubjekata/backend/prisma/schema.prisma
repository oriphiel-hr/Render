generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Snimka /promjene — prvo na disk (meta.json + promjene.jsonl), zatim sync u bazu.
model StagedSnapshot {
  id           String     @id @default(cuid())
  snapshotId   Int        @unique
  metaJson     Json
  diskRelPath  String
  rowCount     Int        @default(0)
  savedAt      DateTime
  dbSyncedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  promjene     Promjena[]
  datasets     StagedDataset[]

  @@map("staged_snapshots")
}

/// SCN diff između dviju snimki — disk pa baza.
model StagedDiff {
  id             String     @id @default(cuid())
  snapshotIdFrom Int
  snapshotIdTo   Int
  metaJson       Json
  diskRelPath    String
  diffRowCount   Int        @default(0)
  savedAt        DateTime
  dbSyncedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  promjene       Promjena[]

  @@unique([snapshotIdFrom, snapshotIdTo])
  @@map("staged_diffs")
}

/// Indeks promjena (cijela snimka ili diff red).
model Promjena {
  id             String          @id @default(cuid())
  mbs            Int
  promjenaId     BigInt
  vrijeme        DateTime
  scn            BigInt
  snapshotId     Int?
  snapshotIdFrom Int?
  snapshotIdTo   Int?
  vrsta          String?
  scnStaro       BigInt?
  stagedSnapshotId String?
  stagedDiffId     String?
  createdAt      DateTime        @default(now())
  stagedSnapshot StagedSnapshot? @relation(fields: [stagedSnapshotId], references: [id], onDelete: Cascade)
  stagedDiff     StagedDiff?     @relation(fields: [stagedDiffId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, promjenaId])
  @@unique([snapshotIdFrom, snapshotIdTo, mbs])
  @@index([snapshotId])
  @@index([snapshotIdTo])
  @@index([mbs])
  @@map("promjene")
}

/// Jedan Sudreg endpoint (subjekti, tvrtke, …) — JSONL na disku pa redovi u bazi.
model StagedDataset {
  id           String       @id @default(cuid())
  snapshotId   Int
  datasetKey   String
  apiPath      String
  label        String
  metaJson     Json
  diskRelPath  String
  rowCount     Int          @default(0)
  savedAt      DateTime
  dbSyncedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  stagedSnapshot StagedSnapshot? @relation(fields: [stagedSnapshotId], references: [id], onDelete: Cascade)
  stagedSnapshotId String?
  rows         MaticniRed[]

  @@unique([snapshotId, datasetKey])
  @@index([snapshotId])
  @@map("staged_datasets")
}

model MaticniRed {
  id               String        @id @default(cuid())
  snapshotId       Int
  datasetKey       String
  mbs              Int?
  payload          Json
  stagedDatasetId  String
  createdAt        DateTime      @default(now())
  stagedDataset    StagedDataset @relation(fields: [stagedDatasetId], references: [id], onDelete: Cascade)

  @@index([snapshotId, datasetKey])
  @@index([mbs])
  @@map("maticni_redovi")
}

/// Priprema primjene promjena — ne dira staging tablice (promjene, maticni_redovi, …).
model TempApplyRun {
  id               String        @id @default(cuid())
  snapshotIdFrom   Int
  snapshotIdTo     Int
  status           String        @default("running")
  diffRows         Int           @default(0)
  noviCount        Int           @default(0)
  promjenaCount    Int           @default(0)
  neaktivniCount   Int           @default(0)
  subjektRowCount  Int           @default(0)
  maticniRowCount  Int           @default(0)
  baselineSource   String?
  targetSource     String?
  metaJson         Json?
  createdAt        DateTime      @default(now())
  completedAt      DateTime?
  subjekti         TempSubjekt[]
  maticni          TempMaticni[]

  @@unique([snapshotIdFrom, snapshotIdTo])
  @@index([snapshotIdTo])
  @@map("temp_apply_runs")
}

/// Jedan MBS iz diff-a (novi/promjena/neaktivan) — pokretač za sve matične skupove.
model TempSubjekt {
  id               String       @id @default(cuid())
  applyRunId       String
  mbs              Int
  vrsta            String
  snapshotIdFrom   Int
  snapshotIdTo     Int
  payload          Json
  promjenaJson     Json?
  createdAt        DateTime     @default(now())
  applyRun         TempApplyRun @relation(fields: [applyRunId], references: [id], onDelete: Cascade)

  @@unique([applyRunId, mbs])
  @@index([snapshotIdTo, vrsta])
  @@index([mbs])
  @@map("temp_subjekti")
}

/// Matični red u pripremi — svi skupovi s MBS (subjekti, tvrtke, sjedišta, …).
model TempMaticni {
  id               String       @id @default(cuid())
  applyRunId       String
  mbs              Int
  datasetKey       String
  rowKey           String       @default("_")
  vrsta            String
  snapshotIdFrom   Int
  snapshotIdTo     Int
  payload          Json
  createdAt        DateTime     @default(now())
  applyRun         TempApplyRun @relation(fields: [applyRunId], references: [id], onDelete: Cascade)

  @@unique([applyRunId, mbs, datasetKey, rowKey])
  @@index([snapshotIdTo, datasetKey])
  @@index([mbs])
  @@map("temp_maticni")
}
