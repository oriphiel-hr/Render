generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Snimka /promjene — prvo na disk (meta.json + promjene.jsonl), zatim sync u bazu.
model StagedSnapshot {
  id           String     @id @default(cuid())
  snapshotId   Int        @unique
  metaJson     Json
  diskRelPath  String
  rowCount     Int        @default(0)
  savedAt      DateTime
  dbSyncedAt   DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  promjene     Promjena[]
  datasets     StagedDataset[]

  @@map("staged_snapshots")
}

/// SCN diff između dviju snimki — disk pa baza.
model StagedDiff {
  id             String     @id @default(cuid())
  snapshotIdFrom Int
  snapshotIdTo   Int
  metaJson       Json
  diskRelPath    String
  diffRowCount   Int        @default(0)
  savedAt        DateTime
  dbSyncedAt     DateTime?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  promjene       Promjena[]

  @@unique([snapshotIdFrom, snapshotIdTo])
  @@map("staged_diffs")
}

/// Indeks promjena (cijela snimka ili diff red).
model Promjena {
  id             String          @id @default(cuid())
  mbs            Int
  promjenaId     BigInt
  vrijeme        DateTime
  scn            BigInt
  snapshotId     Int?
  snapshotIdFrom Int?
  snapshotIdTo   Int?
  vrsta          String?
  scnStaro       BigInt?
  stagedSnapshotId String?
  stagedDiffId     String?
  createdAt      DateTime        @default(now())
  stagedSnapshot StagedSnapshot? @relation(fields: [stagedSnapshotId], references: [id], onDelete: Cascade)
  stagedDiff     StagedDiff?     @relation(fields: [stagedDiffId], references: [id], onDelete: Cascade)

  @@unique([snapshotId, promjenaId])
  @@unique([snapshotIdFrom, snapshotIdTo, mbs])
  @@index([snapshotId])
  @@index([snapshotIdTo])
  @@index([mbs])
  @@map("promjene")
}

/// Jedan Sudreg endpoint (subjekti, tvrtke, …) — JSONL na disku pa redovi u bazi.
model StagedDataset {
  id           String       @id @default(cuid())
  snapshotId   Int
  datasetKey   String
  apiPath      String
  label        String
  metaJson     Json
  diskRelPath  String
  rowCount     Int          @default(0)
  savedAt      DateTime
  dbSyncedAt   DateTime?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  stagedSnapshot StagedSnapshot? @relation(fields: [stagedSnapshotId], references: [id], onDelete: Cascade)
  stagedSnapshotId String?
  rows         MaticniRed[]

  @@unique([snapshotId, datasetKey])
  @@index([snapshotId])
  @@map("staged_datasets")
}

model MaticniRed {
  id               String        @id @default(cuid())
  snapshotId       Int
  datasetKey       String
  mbs              Int?
  rowKey           String        @default("_0") @map("row_key")
  payload          Json
  stagedDatasetId  String
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt @map("updated_at")
  stagedDataset    StagedDataset @relation(fields: [stagedDatasetId], references: [id], onDelete: Cascade)
  changeLogs       MaticniChangeLog[]

  @@unique([datasetKey, mbs, rowKey])
  @@index([snapshotId, datasetKey])
  @@index([mbs])
  @@map("maticni_redovi")
}

/// Audit: UPDATE/DELETE + changed_columns / field_changes (novi zapisi samo u maticni_redovi).
model MaticniChangeLog {
  id               String    @id @default(cuid())
  snapshotIdFrom   Int       @map("snapshot_id_from")
  snapshotIdTo     Int       @map("snapshot_id_to")
  datasetKey       String    @map("dataset_key")
  mbs              Int
  rowKey           String    @default("_0") @map("row_key")
  operation        String
  vrsta            String?
  changedColumns   Json?     @map("changed_columns")
  fieldChanges     Json?     @map("field_changes")
  payloadBefore    Json?     @map("payload_before")
  payloadAfter     Json?     @map("payload_after")
  maticniRedId     String?   @map("maticni_red_id")
  appliedAt        DateTime  @default(now()) @map("applied_at")
  maticniRed       MaticniRed? @relation(fields: [maticniRedId], references: [id], onDelete: SetNull)

  @@index([snapshotIdTo])
  @@index([snapshotIdFrom, snapshotIdTo])
  @@index([mbs])
  @@index([operation])
  @@index([appliedAt])
  @@map("maticni_change_log")
}

/// Denormalizirani subjekti za brzu pretragu (iz subjekti + tvrtka + pravni_oblici).
model SubjektIndeks {
  id                      String    @id @default(cuid())
  snapshotId              Int
  mbs                     Int
  oib                     Int?
  status                  Int?
  naziv                   String?
  skracenaTvrtka          String?   @map("skracena_tvrtka")
  vrstaPravnogOblikaId    Int?      @map("vrsta_pravnog_oblika_id")
  vrstaPravnogOblikaSifra String?   @map("vrsta_pravnog_oblika_sifra")
  vrstaPravnogOblikaNaziv String?   @map("vrsta_pravnog_oblika_naziv")
  datumBrisanja           DateTime? @map("datum_brisanja") @db.Date
  postupak                String?
  glavnaDjelatnost        String?   @map("glavna_djelatnost")
  sudIdNadlezan           Int?      @map("sud_id_nadlezan")
  syncedAt                DateTime  @default(now()) @map("synced_at")
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  @@unique([snapshotId, mbs])
  @@index([snapshotId, status])
  @@index([snapshotId, oib])
  @@index([snapshotId, naziv])
  @@map("subjekti_indeks")
}

/// Priprema primjene promjena — ne dira staging tablice (promjene, maticni_redovi, …).
model TempApplyRun {
  id               String        @id @default(cuid())
  snapshotIdFrom   Int
  snapshotIdTo     Int
  status           String        @default("running")
  diffRows         Int           @default(0)
  noviCount        Int           @default(0)
  promjenaCount    Int           @default(0)
  neaktivniCount   Int           @default(0)
  subjektRowCount  Int           @default(0)
  maticniRowCount  Int           @default(0)
  baselineSource   String?
  targetSource     String?
  metaJson         Json?
  createdAt        DateTime      @default(now())
  completedAt      DateTime?
  subjekti         TempSubjekt[]
  maticni          TempMaticni[]

  @@unique([snapshotIdFrom, snapshotIdTo])
  @@index([snapshotIdTo])
  @@map("temp_apply_runs")
}

/// Jedan MBS iz diff-a (novi/promjena/neaktivan) — pokretač za sve matične skupove.
model TempSubjekt {
  id               String       @id @default(cuid())
  applyRunId       String
  mbs              Int
  vrsta            String
  snapshotIdFrom   Int
  snapshotIdTo     Int
  payload          Json
  promjenaJson     Json?
  createdAt        DateTime     @default(now())
  applyRun         TempApplyRun @relation(fields: [applyRunId], references: [id], onDelete: Cascade)

  @@unique([applyRunId, mbs])
  @@index([snapshotIdTo, vrsta])
  @@index([mbs])
  @@map("temp_subjekti")
}

/// Matični red u pripremi — svi skupovi s MBS (subjekti, tvrtke, sjedišta, …).
model TempMaticni {
  id               String       @id @default(cuid())
  applyRunId       String
  mbs              Int
  datasetKey       String
  rowKey           String       @default("_")
  vrsta            String
  snapshotIdFrom   Int
  snapshotIdTo     Int
  payload          Json
  createdAt        DateTime     @default(now())
  applyRun         TempApplyRun @relation(fields: [applyRunId], references: [id], onDelete: Cascade)

  @@unique([applyRunId, mbs, datasetKey, rowKey])
  @@index([snapshotIdTo, datasetKey])
  @@index([mbs])
  @@map("temp_maticni")
}
